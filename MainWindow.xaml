<Window x:Class="Universum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Universum.ViewModels"
        Title="Universum" Width="1120" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="pack://application:,,,/Assets/universum.ico"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Карточка приложения -->
        <DataTemplate x:Key="AppCard" DataType="{x:Type vm:AppItem}">
            <Border x:Name="Card" Width="340" Height="286" Margin="0,0,14,14" CornerRadius="12"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Border CornerRadius="11" Background="{Binding Glow}" Padding="20,16,20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Версия + GitHub -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding OpenGitHubCommand}" ToolTip="Открыть репозиторий">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="GitHub" Style="{StaticResource Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="5,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="Ver" Text="{Binding VersionLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Muted}" />
                        </DockPanel>

                        <!-- Иконка и название -->
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid Width="52" Height="52">
                                <Border CornerRadius="12" Background="{Binding Accent}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding Monogram}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- Статус -->
                        <Border x:Name="Badge" Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Left" CornerRadius="5" Padding="8,3"
                                Background="#1A7AA2FF" BorderBrush="#337AA2FF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Blue}" VerticalAlignment="Center" />
                                <TextBlock x:Name="BadgeText" Text="{Binding Badge}" Margin="7,0,0,0" FontSize="11.5" Foreground="{StaticResource Blue}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="#C3C6D0" LineHeight="18" MaxHeight="36" TextTrimming="WordEllipsis" />

                        <TextBlock Grid.Row="5" Margin="0,0,0,12" Text="{Binding ReleaseText}" FontSize="11.5" Foreground="{StaticResource Faint}" />

                        <!-- Действия -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="Primary" Style="{StaticResource PrimaryButton}" Command="{Binding PrimaryCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding PrimaryText}" />
                            </Button>

                            <Grid Height="36" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,7" />
                                    <ProgressBar Style="{StaticResource ThinProgress}" Foreground="{Binding Accent}"
                                                 Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource LinkButton}" Command="{Binding CancelCommand}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource Vis}}" ToolTip="Отменить">
                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                </Button>
                            </Grid>

                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource IconButton}" Content="&#xE712;"
                                    Click="MoreButton_Click" ToolTip="Ещё">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding ReleaseMenuText}" Tag="&#xE946;" Command="{Binding OpenReleaseCommand}" />
                                        <MenuItem Header="Страница на GitHub" Tag="&#xE8A7;" Command="{Binding OpenGitHubCommand}" />
                                        <Separator />
                                        <MenuItem Header="Открыть папку" Tag="&#xE838;" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="Переустановить" Tag="&#xE72C;" Command="{Binding ReinstallCommand}" />
                                        <MenuItem Header="Удалить" Tag="&#xE74D;" Command="{Binding UninstallCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                </Trigger>
                <DataTrigger Binding="{Binding PrimaryIsOutline}" Value="True">
                    <Setter TargetName="Primary" Property="Style" Value="{StaticResource GhostButton}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                    <Setter TargetName="Ver" Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="update">
                    <Setter TargetName="Badge" Property="Background" Value="#1AF5B83D" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="#40F5B83D" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="installed">
                    <Setter TargetName="Badge" Property="Background" Value="#144ADE80" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="#334ADE80" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Green}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="none">
                    <Setter TargetName="Badge" Property="Background" Value="#10FFFFFF" />
                    <Setter TargetName="Badge" Property="BorderBrush" Value="#20FFFFFF" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Faint}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <!-- Логотип: звезда со спутником -->
                        <Canvas Width="26" Height="26">
                            <Ellipse Canvas.Left="-4" Canvas.Top="-3" Width="30" Height="30">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#558C78FF" Offset="0" />
                                        <GradientStop Color="#008C78FF" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path Canvas.Top="2" Data="M12,1 C12.88,8.48 15.52,11.12 23,12 C15.52,12.88 12.88,15.52 12,23 C11.12,15.52 8.48,12.88 1,12 C8.48,11.12 11.12,8.48 12,1 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.2,0.1" EndPoint="0.8,0.95">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#7DD3FC" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Canvas.Left="17" Canvas.Top="-1" Fill="#C4B5FD"
                                  Data="M4,0 C4.3,2.5 5.5,3.7 8,4 C5.5,4.3 4.3,5.5 4,8 C3.7,5.5 2.5,4.3 0,4 C2.5,3.7 3.7,2.5 4,0 Z" />
                        </Canvas>
                        <TextBlock Text="UNIVERSUM" Margin="12,0,0,0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                        <Border Width="1" Height="16" Margin="16,0" Background="{StaticResource LineStrong}" />
                        <TextBlock Text="хаб приложений" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersionLabel}" Style="{StaticResource Label}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Faint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Панель инструментов -->
            <Grid Grid.Row="1" Margin="24,20,24,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Приложения" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" Margin="14,0,0,0" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Проверить обновления"
                            RenderTransformOrigin="0.5,0.5">
                        <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="Spin" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SpinRun">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinRun" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}" Margin="0,0,14,0"
                            Visibility="{Binding HasUpdates, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding UpdateAllText}" />
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="А–Я" Command="{Binding SortCommand}" CommandParameter="0"
                                         IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Обновления" Command="{Binding SortCommand}" CommandParameter="1"
                                         IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Sort" Content="Новые" Command="{Binding SortCommand}" CommandParameter="2"
                                         IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=2}" />
                        </StackPanel>
                    </Border>

                    <TextBox Width="230" Style="{StaticResource SearchBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!-- Новая версия самого Universum -->
            <Border Grid.Row="2" Margin="24,10,24,4" CornerRadius="10" Padding="16,12" Background="#1AF5B83D" BorderBrush="#40F5B83D" BorderThickness="1"
                    Visibility="{Binding HasSelfUpdate, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Amber}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelfUpdateTitle}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelfUpdateSubtitle}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                   Visibility="{Binding IsSelfUpdating, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <StackPanel Margin="0,4,0,0" Visibility="{Binding IsSelfUpdating, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding SelfUpdateStatus}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Foreground="{StaticResource Amber}" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                         Value="{Binding SelfUpdateProgress, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding SelfUpdateCommand}" VerticalAlignment="Center">
                        <TextBlock Text="Обновить и перезапустить" />
                    </Button>
                </Grid>
            </Border>

            <!-- Каталог -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="24,10,10,10" Focusable="False">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasInstalled, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding InstalledHeader}" Style="{StaticResource Label}" Margin="0,8,0,12" />
                        <ItemsControl ItemsSource="{Binding InstalledApps}" ItemTemplate="{StaticResource AppCard}" ItemsPanel="{StaticResource WrapPanel}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasAvailable, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding AvailableHeader}" Style="{StaticResource Label}" Margin="0,18,0,12" />
                        <ItemsControl ItemsSource="{Binding AvailableApps}" ItemTemplate="{StaticResource AppCard}" ItemsPanel="{StaticResource WrapPanel}" />
                    </StackPanel>

                    <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="{Binding NothingFound, Converter={StaticResource Vis}}">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                        <TextBlock Text="Ничего не найдено" Margin="0,12,0,0" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock Text="Попробуйте другой запрос" Margin="0,4,0,0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Подвал -->
            <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="Profile_Click">
                        <TextBlock Text="github.com/kolyaka6969-ops" Style="{StaticResource Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <TextBlock Text="{Binding Footer}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
