<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Universum</AssemblyName>
    <RootNamespace>Universum</RootNamespace>
    <ApplicationIcon>Assets\universum.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Universum</Product>
    <Description>Хаб приложений: установка и обновление Volumix, Orbit и других.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="catalog.json" />
    <Resource Include="Assets\universum.ico" />
  </ItemGroup>

</Project>
